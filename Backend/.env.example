APP_NAME=MediMall API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://medimall:medimall@localhost:5432/medimall
FRONTEND_ORIGIN=http://localhost:3000
SECRET_KEY=replace-with-a-long-random-secret
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
# Email Service Configuration (Use either SMTP or Resend)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=MediMall <your_email@gmail.com>
SMTP_USE_TLS=true

# Alternative: Resend API (Requires custom domain to send to arbitrary recipients)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=MediMall <onboarding@resend.dev>

FRONTEND_URL=http://localhost:3000
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
